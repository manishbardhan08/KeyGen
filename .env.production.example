# ==================================================================
#  KeyVault — production environment template
#  Copy to `.env` on the server and fill in the real values.
#    cp .env.production.example .env
#  NEVER commit the real `.env`.
# ==================================================================

CI_ENVIRONMENT = production

# ------------------------------------------------------------------
# APP
# ------------------------------------------------------------------
# Set this to your real HTTPS domain, WITH trailing slash.
app.baseURL = 'https://your-domain.com/'

# Force every request over HTTPS + send HSTS. Keep true in production.
app.forceGlobalSecureRequests = true

# Optional: tighten to your hostnames (guards against Host-header injection)
# app.allowedHostnames = ['your-domain.com']

# Panel auto-logout after N minutes of inactivity (0 disables). Default 30.
# app.autoLogoutMinutes = 30

# "Remember me" persistent-login lifetime in days (0 disables). Default 30.
# app.rememberMeDays = 30

# Behind a reverse proxy / CDN: tell CI4 which header carries the real client IP,
# or the API rate-limit and HTTPS detection will see the proxy instead.
# app.proxyIPs = {"127.0.0.1": "X-Forwarded-For"}

# ------------------------------------------------------------------
# DATABASE  (use a dedicated, least-privilege user — NOT root)
# ------------------------------------------------------------------
database.default.hostname = 127.0.0.1
database.default.database = authgen
database.default.username = authgen_app
database.default.password = CHANGE_ME_STRONG_PASSWORD
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

# ------------------------------------------------------------------
# ENCRYPTION  (generate a fresh key: php spark key:generate)
# ------------------------------------------------------------------
encryption.key = hex2bin:PASTE_64_HEX_CHARS_HERE

# ------------------------------------------------------------------
# SESSION  (secure cookie flags are auto-set in production)
# ------------------------------------------------------------------
# session.driver = 'CodeIgniter\Session\Handlers\FileHandler'

# ------------------------------------------------------------------
# LOGGER
# ------------------------------------------------------------------
logger.threshold = 4

# Assets served locally
assets.cdnURL = ""