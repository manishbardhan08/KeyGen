# ==================================================================
#  KeyGen — PRODUCTION environment
# ==================================================================
#  HOW TO USE (on the server):
#
#    cd /var/www/keygen
#    cp .env.production.example .env
#    php spark key:generate          # writes a fresh encryption.key into .env
#    nano .env                        # fill the 4 things marked  >> CHANGE
#    php spark db:create keygen      # first time only
#    php spark migrate                # creates all tables
#    php spark db:seed OwnerSeeder    # creates the owner from OWNER_* below
#
#  Rule of thumb: wrap any value containing spaces or "#" in single quotes.
#  NEVER commit the real `.env` (only this `.example` is committed).
#
#  >> CHANGE-ME CHECKLIST
#   1. app.baseURL                      -> your real https domain
#   2. database.default.password        -> strong, unique DB password
#   3. encryption.key                   -> run: php spark key:generate
#   4. OWNER_NAME / OWNER_USERNAME / OWNER_PASSWORD -> your owner login
#  (Optionally also set app.allowedHostnames and app.proxyIPs, see below.)
# ==================================================================

# ------------------------------------------------------------------
# ENVIRONMENT  — must stay "production"
# ------------------------------------------------------------------
CI_ENVIRONMENT = production

# ------------------------------------------------------------------
# APP
# ------------------------------------------------------------------
# Your real HTTPS domain, WITH a trailing slash.
app.baseURL = 'https://your-domain.com/'

# Force every request over HTTPS + send HSTS. Keep true in production.
app.forceGlobalSecureRequests = true

# Host-header guard: only accept these hostnames (blocks typo/squat domains).
# app.allowedHostnames = ['your-domain.com', 'www.your-domain.com']

# Panel auto-logout after N minutes of inactivity (0 disables). Default 30.
app.autoLogoutMinutes = 30

# "Remember me" lifetime in days. 0 = HARD logout: after the idle timeout a
# reload goes back to /login (no silent re-login from the remember cookie).
app.rememberMeDays = 0

# Timestamps are stored in this timezone.
app.appTimezone = 'UTC'

# Content-Security-Policy is enabled by default. Leave it on unless you embed
# third-party scripts that are not already whitelisted in
# Config/ContentSecurityPolicy.php.
# app.CSPEnabled = true

# ------------------------------------------------------------------
# BEHIND A REVERSE PROXY / CLOUDFLARE
# ------------------------------------------------------------------
# Without this, the API rate-limit and the "is it HTTPS?" check see the proxy
# IP, not the real client. Map the header your proxy sends:
#   - nginx/Caddy on the same box : X-Forwarded-For from 127.0.0.1
#   - Cloudflare                  : CF-Connecting-IP
# app.proxyIPs = {"127.0.0.1": "X-Forwarded-For"}
# app.proxyIPs = {"127.0.0.1": "CF-Connecting-IP"}

# ------------------------------------------------------------------
# DATABASE  — dedicated, least-privilege user (NOT root)
# ------------------------------------------------------------------
database.default.hostname = 127.0.0.1
database.default.database = keygen
database.default.username = keygen_app
database.default.password = CHANGE_ME_STRONG_DB_PASSWORD
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

# ------------------------------------------------------------------
# ENCRYPTION  — generate ONCE, then NEVER change it
#   php spark key:generate
# It encrypts the stored api_key_display copies; losing it makes them
# unreadable. Back it up somewhere safe (password manager).
# ------------------------------------------------------------------
encryption.key = hex2bin:PASTE_64_HEX_CHARS_HERE

# ------------------------------------------------------------------
# SESSION
#   Secure / HttpOnly / SameSite flags are auto-enabled in production.
# ------------------------------------------------------------------
# Server-side idle timeout in SECONDS before the user must sign in again
# (1800 = 30 min). Keep in sync with app.autoLogoutMinutes above.
session.expiration = 1800

# ------------------------------------------------------------------
# OWNER ACCOUNT  — used by: php spark db:seed OwnerSeeder
#   OWNER_PASSWORD is REQUIRED in production (the seeder refuses to run
#   without it, so the dev default can never leak into a live install).
#   Seeder is safe to re-run: if the username already exists it just skips.
# ------------------------------------------------------------------
OWNER_NAME     = 'Your Name'
OWNER_USERNAME = 'your-username'
OWNER_PASSWORD = 'a-strong-unique-password'

# ------------------------------------------------------------------
# LOGGER  — 1 = errors only, 4 = all levels (debug). 4 is fine while
# settling in; switch to 2-3 later to keep logs small.
# ------------------------------------------------------------------
logger.threshold = 4
